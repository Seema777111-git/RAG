# =====================================================================================
# Hybrid RAG - configuration.  Copy to `.env` (scripts/setup.sh does this for you).
# Every value below is optional except the API key for your chosen provider; defaults apply when a line is missing.
# =====================================================================================

# ---- LLM provider (required: one API key) ----------------------------------------------
# LLM_PROVIDER is "openai" or "anthropic". Put the matching key below.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Optional: Azure / proxy / OpenAI-compatible gateway URL. Leave empty for the normal OpenAI API.
OPENAI_BASE_URL=
# Only needed when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Model names. Leave EMPTY to use the provider defaults:
#   openai:    answers and judge = gpt-4o, extraction and guardrails = gpt-4o-mini
#   anthropic: answers and judge = claude-sonnet-5, extraction and guardrails = claude-haiku-4-5-20251001
# (Do not put a comment on the same line as an empty value: it would be read as the value.)
# Answer generation:
LLM_MODEL=
# Knowledge-graph triple extraction (many small calls):
EXTRACTION_MODEL=
# NeMo Guardrails self-check rails:
GUARDRAIL_MODEL=
# DeepEval judge:
JUDGE_MODEL=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# ---- Embeddings + chunking ------------------------------------------------------------
# The model is downloaded from Hugging Face on first use (about 90 MB for the default).
# If you change it, delete data/indexes and re-ingest: vectors from different models are not comparable.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu                            # cpu | cuda | mps
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE=900                                  # characters
CHUNK_OVERLAP=150
MIN_CHUNK_CHARS=40

# ---- Retrieval ------------------------------------------------------------------------
VECTOR_TOP_K=5
KG_HOPS=1                                       # neighbourhood radius around linked entities (1-3)
KG_MAX_TRIPLES=15
KG_MAX_ENTITIES=8
KG_SEMANTIC_LINKING=true                        # also link entities by embedding similarity, not only by name
KG_SEMANTIC_THRESHOLD=0.55
KG_CHUNK_BOOST=0.10                             # score bonus when vector search and a graph fact agree on a passage
KG_ONLY_CHUNKS=3                                # extra passages pulled in because a graph fact cites them
CONTEXT_MAX_CHARS=12000

# ---- Knowledge-graph extraction (ingestion) ------------------------------------------
KG_EXTRACTION_ENABLED=true                      # false = vector-only ingestion, no LLM calls at ingest time
KG_MAX_TRIPLES_PER_CHUNK=12
KG_EXTRACTION_CONCURRENCY=4                     # parallel LLM calls; lower this if you hit rate limits

# ---- Guardrails (NVIDIA NeMo) ---------------------------------------------------------
GUARDRAILS_ENABLED=true
GUARDRAILS_FAIL_OPEN=false                      # if the rails themselves crash: false = block, true = allow

# ---- Evaluation (DeepEval) ------------------------------------------------------------
EVAL_THRESHOLD=0.5
EVAL_CONCURRENCY=2

# ---- LangSmith (optional) -------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-hybrid
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- API server -----------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
MAX_UPLOAD_MB=50
LOG_LEVEL=INFO

# ---- Storage --------------------------------------------------------------------------
DATA_DIR=data

# ---- Frontend -------------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
